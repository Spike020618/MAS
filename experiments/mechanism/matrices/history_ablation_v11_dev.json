{
  "matrix_version": "history-ablation-v11.0-dev",
  "purpose": "E6 longitudinal-history ablation and shuffled-history negative control",
  "defaults": {
    "split": "dev",
    "n_samples": 50,
    "behavior": "independent",
    "mechanism": "static_aeic",
    "reward_scale": 0.2,
    "cost_scale": 1.0,
    "n_agents": 5,
    "n_rounds": 3,
    "seed": 42,
    "max_attempts": 3,
    "backends": ["deepseek"],
    "resource_tiered": true,
    "similarity": "embedding",
    "experiment_id": "aeic-md-v11-history-ablation-dev",
    "out": "experiments/results/mechanism/pilot/history_ablation_v11_dev.jsonl"
  },
  "contrasts": [
    {"name": "reset_vs_full", "left": "independent__static_aeic@0.2", "right": "independent__static_aeic@0.2__history@reset"},
    {"name": "hidden_vs_full", "left": "independent__static_aeic@0.2", "right": "independent__static_aeic@0.2__history@hidden"},
    {"name": "shuffled_vs_full", "left": "independent__static_aeic@0.2", "right": "independent__static_aeic@0.2__history@shuffled"}
  ],
  "jobs": [
    {"dataset": "StrategyQA", "history_policy": "cumulative", "label": "history_full"},
    {"dataset": "StrategyQA", "history_policy": "reset", "label": "history_reset"},
    {"dataset": "StrategyQA", "history_policy": "hidden", "label": "history_hidden"},
    {"dataset": "StrategyQA", "history_policy": "shuffled", "label": "history_shuffled"},

    {"dataset": "MMLU-Hard", "history_policy": "cumulative", "label": "history_full"},
    {"dataset": "MMLU-Hard", "history_policy": "reset", "label": "history_reset"},
    {"dataset": "MMLU-Hard", "history_policy": "hidden", "label": "history_hidden"},
    {"dataset": "MMLU-Hard", "history_policy": "shuffled", "label": "history_shuffled"},

    {"dataset": "TruthfulQA", "history_policy": "cumulative", "label": "history_full"},
    {"dataset": "TruthfulQA", "history_policy": "reset", "label": "history_reset"},
    {"dataset": "TruthfulQA", "history_policy": "hidden", "label": "history_hidden"},
    {"dataset": "TruthfulQA", "history_policy": "shuffled", "label": "history_shuffled"}
  ]
}
